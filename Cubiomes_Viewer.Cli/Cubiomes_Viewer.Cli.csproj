<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>cubiomes-viewer-cli</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Cubiomes Viewer CLI</AssemblyTitle>
    <Description>Runs Cubiomes Viewer seed searches without the app.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cubiomes_Viewer.Engine\Cubiomes_Viewer.Engine.csproj" />
  </ItemGroup>

  <Import Project="..\native\CvNative.Desktop.targets" />

  <Target Name="StripPdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
