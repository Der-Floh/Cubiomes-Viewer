<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <ApplicationId>io.github.der_floh.cubiomesviewer</ApplicationId>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Cubiomes Viewer</AssemblyTitle>
    <Description>Android host for Cubiomes Viewer.</Description>
  </PropertyGroup>

  <!-- Android only installs an update whose version code is higher, so 5.1.2 becomes 5001002. -->
  <PropertyGroup>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ReleaseVersionNumber>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value)</ReleaseVersionNumber>
    <ReleaseMajor>$([System.Version]::Parse('$(ReleaseVersionNumber)').Major)</ReleaseMajor>
    <ReleaseMinor>$([System.Version]::Parse('$(ReleaseVersionNumber)').Minor)</ReleaseMinor>
    <ReleasePatch>$([System.Version]::Parse('$(ReleaseVersionNumber)').Build)</ReleasePatch>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(ReleaseMajor), 1000000)), $([MSBuild]::Multiply($(ReleaseMinor), 1000)))), $(ReleasePatch)))</ApplicationVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == '0'">1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cubiomes_Viewer\Cubiomes_Viewer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\LICENSE.txt" Link="Assets\LICENSE.txt" />
    <AndroidAsset Include="..\THIRD-PARTY-NOTICES.md" Link="Assets\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <Import Project="..\native\CvNative.Android.targets" />
</Project>
