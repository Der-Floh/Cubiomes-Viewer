<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Cubiomes Viewer</Product>
    <Company>Der_Floh</Company>
    <Authors>Der_Floh</Authors>
    <Copyright>Copyright © 2026 Der_Floh</Copyright>
    <Version>0.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Leaves out the translations of packages such as System.CommandLine, whose messages would follow the language of the machine. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
