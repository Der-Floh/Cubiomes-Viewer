<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cubiomes_Viewer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="28"
             x:Class="Cubiomes_Viewer.Views.StatusBarView"
             x:DataType="vm:MapViewModel">

    <Border Classes="status-bar">
        <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="status" Text="{Binding HoverText}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Classes="status damp" Text="{Binding GeneratingLabel}" IsVisible="{Binding IsGenerating}"/>
            <TextBlock Grid.Column="2" Classes="status damp" Text="{Binding ScaleText}"/>
        </Grid>
    </Border>

</UserControl>
