<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:style="using:Cubiomes_Viewer.Service.MapStyleServ"
             mc:Ignorable="d" d:DesignWidth="20" d:DesignHeight="20"
             x:Class="Cubiomes_Viewer.Views.MarkerBadgeView"
             x:DataType="style:MapMarker">

    <Border Classes="marker" Background="{Binding Fill}">
        <Viewbox Classes="marker-glyph">
            <Path Classes="marker-glyph" Data="{Binding Glyph}"/>
        </Viewbox>
    </Border>

</UserControl>
