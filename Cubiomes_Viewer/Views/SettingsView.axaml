<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cubiomes_Viewer.ViewModels"
             xmlns:views="using:Cubiomes_Viewer.Views"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="Cubiomes_Viewer.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer>
        <StackPanel Classes="panel">
            <TextBlock Classes="title" Text="{Binding Title}"/>

            <TextBlock Classes="section" Text="{Binding AppearanceLabel}"/>
            <TextBlock Classes="field-label" Text="{Binding ThemeLabel}"/>
            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch"/>

            <TextBlock Classes="section" Text="{Binding MapLabel}"/>
            <CheckBox Content="{Binding SmoothMotionLabel}" IsChecked="{Binding SmoothMotion}"/>
            <TextBlock Classes="field-label" Text="{Binding CacheLabel}"/>
            <NumericUpDown Value="{Binding CacheMegabytes}" Minimum="{Binding MinCacheMegabytes}" Maximum="{Binding MaxCacheMegabytes}" Increment="64" FormatString="0"/>
            <Grid Classes="pair" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                <TextBlock Classes="field-label" Text="{Binding GridSpacingLabel}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Classes="field-label" Text="{Binding GridMultiplierLabel}" TextWrapping="Wrap"/>
                <NumericUpDown Grid.Row="1" Classes="plain" Value="{Binding GridSpacing}" Minimum="{Binding MinGridSpacingValue}" Maximum="{Binding MaxGridSpacingValue}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Classes="fill" ItemsSource="{Binding GridMultipliers}" SelectedItem="{Binding SelectedGridMultiplier}"/>
            </Grid>
            <TextBlock Classes="field-label" Text="{Binding MarkerSizeLabel}"/>
            <ComboBox Classes="fill" ItemsSource="{Binding MarkerSizes}" SelectedItem="{Binding SelectedMarkerSize}"/>
            <Expander Header="{Binding ZoomLimitsLabel}" HorizontalAlignment="Stretch">
                <StackPanel Classes="form">
                    <TextBlock Classes="damp" Text="{Binding ZoomLimitsHint}" TextWrapping="Wrap"/>
                    <ItemsControl Classes="rows" ItemsSource="{Binding ZoomLimits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StructureZoomLimitViewModel">
                                <Grid Classes="pair" ColumnDefinitions="*,*">
                                    <TextBlock Classes="color-name" Text="{Binding Name}"/>
                                    <ComboBox Grid.Column="1" Classes="fill" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedLimit}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <TextBlock Classes="section" Text="{Binding World.Title}"/>
            <StackPanel Classes="form" DataContext="{Binding World}" x:DataType="vm:WorldSettingsViewModel">
                <CheckBox Content="{Binding ExperimentalVersionsLabel}" IsChecked="{Binding ShowExperimentalVersions}"/>
                <TextBlock Classes="damp" Text="{Binding ExperimentalVersionsHint}" TextWrapping="Wrap"/>
                <CheckBox Content="{Binding EstimateTerrainLabel}" IsChecked="{Binding EstimateTerrain}"/>
                <TextBlock Classes="damp" Text="{Binding EstimateTerrainHint}" TextWrapping="Wrap"/>
                <Expander Header="{Binding SaltsLabel}" HorizontalAlignment="Stretch">
                    <StackPanel Classes="form">
                        <TextBlock Classes="damp" Text="{Binding SaltsHint}" TextWrapping="Wrap"/>
                        <ItemsControl Classes="rows" ItemsSource="{Binding Salts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StructureSaltViewModel">
                                    <Grid Classes="pair" ColumnDefinitions="*,120">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsReplacing}" ToolTip.Tip="{Binding GameSaltHint}"/>
                                        <NumericUpDown Grid.Column="1" Classes="plain" Value="{Binding Salt}" IsEnabled="{Binding IsReplacing}" Minimum="{Binding MinSalt}" Maximum="{Binding MaxSalt}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{Binding GameSaltsLabel}" Command="{Binding UseGameSaltsCommand}" IsEnabled="{Binding HasReplacedSalts}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <TextBlock Classes="section" Text="{Binding StartLabel}"/>
            <CheckBox Content="{Binding RestoreLabel}" IsChecked="{Binding RestoreLastSession}"/>
            <TextBlock Classes="damp" Text="{Binding RestoreHint}" TextWrapping="Wrap"/>
            <CheckBox Content="{Binding RememberWindowLabel}" IsChecked="{Binding RememberWindow}" IsVisible="{Binding CanRememberWindow}"/>

            <TextBlock Classes="section" Text="{Binding ExportLabel}"/>
            <TextBlock Classes="field-label" Text="{Binding CsvSeparatorLabel}"/>
            <ComboBox Classes="fill" ItemsSource="{Binding CsvSeparators}" SelectedItem="{Binding SelectedCsvSeparator}"/>

            <TextBlock Classes="section" Text="{Binding Updates.Title}"/>
            <StackPanel Classes="form" DataContext="{Binding Updates}" x:DataType="vm:UpdateViewModel">
                <TextBlock Text="{Binding VersionText}"/>
                <StackPanel Classes="form" IsVisible="{Binding CanUpdate}">
                    <CheckBox Content="{Binding CheckAtStartLabel}" IsChecked="{Binding CheckAtStart}"/>
                    <TextBlock Classes="damp" Text="{Binding CheckAtStartHint}" TextWrapping="Wrap"/>
                    <WrapPanel Classes="card-actions">
                        <Button Classes="accent" Content="{Binding RestartLabel}" Command="{Binding RestartCommand}" IsVisible="{Binding IsReady}"/>
                        <Button Content="{Binding CheckLabel}" Command="{Binding CheckCommand}" IsVisible="{Binding !IsReady}"/>
                    </WrapPanel>
                    <TextBlock Classes="damp" Text="{Binding StatusText}" TextWrapping="Wrap" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </StackPanel>

            <Expander Classes="section-content" Header="{Binding DiagnosticsLabel}" HorizontalAlignment="Stretch">
                <views:SelfTestView DataContext="{Binding SelfTest}"/>
            </Expander>
        </StackPanel>
    </ScrollViewer>

</UserControl>
