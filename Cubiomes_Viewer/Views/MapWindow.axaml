<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Cubiomes_Viewer.ViewModels"
        xmlns:views="using:Cubiomes_Viewer.Views"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Cubiomes_Viewer.Views.MapWindow"
        x:DataType="vm:MapViewModel"
        Icon="/Assets/icon-x256.png"
        Title="Cubiomes Viewer · Map"
        Width="1000" Height="700"
        MinHeight="300" MinWidth="300"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="*,Auto">
        <Panel Name="MapSlot"/>
        <views:StatusBarView Grid.Row="1"/>
    </Grid>

</Window>
