<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cubiomes_Viewer.ViewModels"
             xmlns:controls="using:Cubiomes_Viewer.Controls"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="60"
             x:Class="Cubiomes_Viewer.Views.NearestSearchView"
             x:DataType="vm:NearestSearchViewModel">

    <Border Classes="task-card" IsVisible="{Binding IsRunning}">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Classes="callout">
                <TextBlock Classes="task-title" Text="{Binding Title}"/>
                <TextBlock Classes="damp" Text="{Binding StatusText}" IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="card-close" Command="{Binding StopCommand}" ToolTip.Tip="{Binding StopLabel}">
                <controls:SvgIcon Source="{StaticResource CloseIcon}"/>
            </Button>
        </Grid>
    </Border>

</UserControl>
