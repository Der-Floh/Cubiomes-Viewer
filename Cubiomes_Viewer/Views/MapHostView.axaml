<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cubiomes_Viewer.ViewModels"
             xmlns:controls="using:Cubiomes_Viewer.Controls"
             xmlns:views="using:Cubiomes_Viewer.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Cubiomes_Viewer.Views.MapHostView"
             x:DataType="vm:MapHostViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding DismissCommand}"/>
    </UserControl.KeyBindings>

    <UserControl.Resources>
        <ControlTheme x:Key="NearestTargetItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:NearestTargetViewModel">
            <Setter Property="Header" Value="{Binding Name}"/>
            <Setter Property="Command" Value="{Binding FindCommand}"/>
        </ControlTheme>
        <ControlTheme x:Key="NearestStructureItem" TargetType="MenuItem" BasedOn="{StaticResource NearestTargetItem}" x:DataType="vm:NearestTargetViewModel">
            <Setter Property="Icon">
                <Template>
                    <views:MarkerBadgeView x:DataType="vm:NearestTargetViewModel" DataContext="{Binding Marker}"/>
                </Template>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <Panel>
        <controls:MapView Name="Map"
                          Camera="{Binding Map.Camera}"
                          World="{Binding Map.World}"
                          SampleHeight="{Binding Map.SampleHeight}"
                          Layer="{Binding Map.Layer}"
                          Octaves="{Binding Map.Octaves}"
                          SmoothMotion="{Binding Map.SmoothMotion}">
            <controls:MapView.ContextFlyout>
                <MenuFlyout>
                    <MenuItem Header="{Binding Menu.CopyCoordinatesLabel}" Command="{Binding Menu.CopyCoordinatesCommand}"/>
                    <MenuItem Header="{Binding Menu.CopyTeleportLabel}" Command="{Binding Menu.CopyTeleportCommand}"/>
                    <MenuItem Header="{Binding Menu.CopyChunkLabel}" Command="{Binding Menu.CopyChunkCommand}"/>
                    <MenuItem Header="{Binding Menu.CopyRegionFileLabel}" Command="{Binding Menu.CopyRegionFileCommand}"/>
                    <MenuItem Header="{Binding Menu.CopySeedLabel}" Command="{Binding Menu.CopySeedCommand}"/>
                    <MenuItem Header="{Binding Menu.CopyLinkLabel}" Command="{Binding Menu.CopyLinkCommand}"/>
                    <Separator/>
                    <MenuItem Header="{Binding Menu.MeasureLabel}" Command="{Binding Menu.ToggleMeasuringCommand}"/>
                    <MenuItem Header="{Binding Menu.PlacePinLabel}" Command="{Binding Menu.PlacePinCommand}"/>
                    <MenuItem Header="{Binding Menu.OtherDimensionLabel}" Command="{Binding Menu.OpenOtherDimensionCommand}" IsVisible="{Binding Menu.CanOpenOtherDimension}"/>
                    <Separator/>
                    <MenuItem Header="{Binding Menu.FindStructureLabel}" ItemsSource="{Binding Menu.StructureTargets}"
                              ItemContainerTheme="{StaticResource NearestStructureItem}" IsEnabled="{Binding Menu.HasStructureTargets}"/>
                    <MenuItem Header="{Binding Menu.FindBiomeLabel}" ItemsSource="{Binding Menu.BiomeTargets}"
                              ItemContainerTheme="{StaticResource NearestTargetItem}" IsEnabled="{Binding Menu.HasBiomeTargets}"/>
                    <Separator/>
                    <MenuItem Header="{Binding Menu.OpenShadowSeedLabel}" Command="{Binding Menu.OpenShadowSeedCommand}"
                              ToolTip.Tip="{Binding Menu.ShadowSeedHint}" ToolTip.ShowOnDisabled="True"/>
                    <MenuItem Header="{Binding Menu.SaveImageLabel}" Command="{Binding Menu.SaveImageCommand}"/>
                </MenuFlyout>
            </controls:MapView.ContextFlyout>
        </controls:MapView>

        <views:LegendView DataContext="{Binding Legend}"/>
        <views:NearestSearchView DataContext="{Binding Nearest}"/>
        <Canvas ClipToBounds="True">
            <views:SelectionCalloutView Name="Callout" DataContext="{Binding Selection}"/>
        </Canvas>
    </Panel>

</UserControl>
