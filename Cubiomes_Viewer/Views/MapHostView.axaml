<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cubiomes_Viewer.ViewModels"
             xmlns:controls="using:Cubiomes_Viewer.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Cubiomes_Viewer.Views.MapHostView"
             x:DataType="vm:MapViewModel">

    <controls:MapView Name="Map"
                      Camera="{Binding Camera}"
                      World="{Binding World}"
                      SampleHeight="{Binding SampleHeight}"
                      SmoothMotion="{Binding SmoothMotion}"/>

</UserControl>
