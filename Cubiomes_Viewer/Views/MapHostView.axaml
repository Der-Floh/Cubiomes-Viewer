<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cubiomes_Viewer.ViewModels"
             xmlns:controls="using:Cubiomes_Viewer.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Cubiomes_Viewer.Views.MapHostView"
             x:DataType="vm:MapHostViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding Menu.StopMeasuringCommand}"/>
    </UserControl.KeyBindings>

    <controls:MapView Name="Map"
                      Camera="{Binding Map.Camera}"
                      World="{Binding Map.World}"
                      SampleHeight="{Binding Map.SampleHeight}"
                      SmoothMotion="{Binding Map.SmoothMotion}">
        <controls:MapView.ContextFlyout>
            <MenuFlyout>
                <MenuItem Header="{Binding Menu.CopyCoordinatesLabel}" Command="{Binding Menu.CopyCoordinatesCommand}"/>
                <MenuItem Header="{Binding Menu.CopyTeleportLabel}" Command="{Binding Menu.CopyTeleportCommand}"/>
                <MenuItem Header="{Binding Menu.CopyChunkLabel}" Command="{Binding Menu.CopyChunkCommand}"/>
                <MenuItem Header="{Binding Menu.CopyRegionFileLabel}" Command="{Binding Menu.CopyRegionFileCommand}"/>
                <MenuItem Header="{Binding Menu.CopySeedLabel}" Command="{Binding Menu.CopySeedCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding Menu.MeasureLabel}" Command="{Binding Menu.ToggleMeasuringCommand}"/>
                <Separator/>
                <MenuItem Header="{Binding Menu.OpenShadowSeedLabel}" Command="{Binding Menu.OpenShadowSeedCommand}"
                          ToolTip.Tip="{Binding Menu.ShadowSeedHint}" ToolTip.ShowOnDisabled="True"/>
                <MenuItem Header="{Binding Menu.SaveImageLabel}" Command="{Binding Menu.SaveImageCommand}"/>
            </MenuFlyout>
        </controls:MapView.ContextFlyout>
    </controls:MapView>

</UserControl>
