<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cubiomes_Viewer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="Cubiomes_Viewer.Views.LayersPanelView"
             x:DataType="vm:LayersPanelViewModel">

    <ScrollViewer>
        <StackPanel Classes="panel">
            <TextBlock Classes="title" Text="{Binding Title}"/>
            <TextBlock Classes="section" Text="{Binding OverlaysLabel}"/>
            <CheckBox Content="{Binding ShowGridLabel}" IsChecked="{Binding ShowGrid}"/>
        </StackPanel>
    </ScrollViewer>

</UserControl>
