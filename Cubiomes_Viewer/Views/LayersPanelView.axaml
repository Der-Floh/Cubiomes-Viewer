<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cubiomes_Viewer.ViewModels"
             xmlns:views="using:Cubiomes_Viewer.Views"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="600"
             x:Class="Cubiomes_Viewer.Views.LayersPanelView"
             x:DataType="vm:LayersPanelViewModel">

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:MarkerToggleViewModel">
            <CheckBox IsChecked="{Binding IsChecked}">
                <StackPanel Classes="marker-label">
                    <views:MarkerBadgeView DataContext="{Binding Marker}"/>
                    <TextBlock Text="{Binding Name}"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Classes="panel">
            <TextBlock Classes="title" Text="{Binding Title}"/>

            <TextBlock Classes="section" Text="{Binding MapLayerLabel}"/>
            <ComboBox Classes="fill" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}"/>
            <ComboBox Classes="fill" ItemsSource="{Binding OctaveChoices}" SelectedItem="{Binding SelectedOctaves}"
                      IsVisible="{Binding HasOctaves}" ToolTip.Tip="{Binding OctavesHint}"/>
            <ComboBox Classes="fill" ItemsSource="{Binding HeightStyles}" SelectedItem="{Binding SelectedHeightStyle}" IsVisible="{Binding IsHeightShown}"/>
            <ComboBox Classes="fill" ItemsSource="{Binding PotentialStructures}" SelectedItem="{Binding SelectedPotentialStructure}"
                      IsVisible="{Binding IsPotentialShown}" ToolTip.Tip="{Binding PotentialHint}"/>

            <TextBlock Classes="section" Text="{Binding BiomeColors.Title}"/>
            <StackPanel Classes="form" DataContext="{Binding BiomeColors}" x:DataType="vm:BiomeColorsViewModel">
                <ComboBox Classes="fill" ItemsSource="{Binding MapChoices}" SelectedItem="{Binding SelectedMap}" IsEnabled="{Binding !IsEditing}"/>
                <WrapPanel Classes="card-actions" IsVisible="{Binding !IsEditing}">
                    <Button Content="{Binding NewLabel}" Command="{Binding NewCommand}"/>
                    <Button Content="{Binding EditLabel}" Command="{Binding EditCommand}"/>
                    <Button Content="{Binding ImportLabel}" Command="{Binding ImportCommand}"/>
                    <Button Content="{Binding ExportLabel}" Command="{Binding ExportCommand}"/>
                    <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}"/>
                </WrapPanel>
                <Border Classes="condition" IsVisible="{Binding IsEditing}">
                    <StackPanel Classes="form">
                        <TextBlock Classes="field-label" Text="{Binding NameLabel}"/>
                        <TextBox Text="{Binding EditName}"/>
                        <TextBlock Classes="damp" Text="{Binding EditHint}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding Filter}" PlaceholderText="{Binding FilterPlaceholder}"/>
                        <Border Classes="choice-list colors">
                            <ScrollViewer>
                                <ItemsControl Classes="rows" ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:BiomeColorEntryViewModel">
                                            <Grid Classes="pair" ColumnDefinitions="Auto,*,Auto">
                                                <ColorPicker Classes="swatch" Color="{Binding Color}"/>
                                                <TextBlock Grid.Column="1" Classes="color-name" Text="{Binding Name}"/>
                                                <Button Grid.Column="2" Classes="compact" Content="{Binding DefaultLabel}" Command="{Binding UseDefaultCommand}" IsVisible="{Binding IsChanged}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <WrapPanel Classes="card-actions">
                            <Button Content="{Binding AllDefaultLabel}" Command="{Binding UseAllDefaultCommand}"/>
                            <Button Content="{Binding AllDimmedLabel}" Command="{Binding UseAllDimmedCommand}"/>
                        </WrapPanel>
                        <WrapPanel Classes="card-actions">
                            <Button Classes="accent" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}"/>
                            <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Classes="section" Text="{Binding OverlaysLabel}"/>
            <CheckBox Content="{Binding ShowGridLabel}" IsChecked="{Binding ShowGrid}"/>
            <CheckBox Content="{Binding ShowSlimeChunksLabel}" IsChecked="{Binding ShowSlimeChunks}" IsVisible="{Binding IsOverworld}"/>
            <CheckBox Content="{Binding ShowGatewayLinksLabel}" IsChecked="{Binding ShowGatewayLinks}" IsVisible="{Binding IsEnd}"/>

            <StackPanel IsVisible="{Binding IsOverworld}">
                <TextBlock Classes="section" Text="{Binding LandmarksLabel}"/>
                <ContentControl Content="{Binding Spawn}"/>
                <ContentControl Content="{Binding Strongholds}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Classes="section" Text="{Binding StructuresLabel}"/>
                <Button Grid.Column="1" Classes="compact" Content="{Binding ShowAllLabel}" Command="{Binding ShowAllStructuresCommand}" IsVisible="{Binding HasStructures}"/>
                <Button Grid.Column="2" Classes="compact" Content="{Binding HideAllLabel}" Command="{Binding HideAllStructuresCommand}" IsVisible="{Binding HasStructures}"/>
            </Grid>
            <TextBlock Classes="damp" Text="{Binding ZoomHint}" TextWrapping="Wrap" IsVisible="{Binding HasStructures}"/>
            <TextBlock Classes="damp" Text="{Binding NoStructuresLabel}" TextWrapping="Wrap" IsVisible="{Binding !HasStructures}"/>
            <ItemsControl ItemsSource="{Binding Structures}"/>
        </StackPanel>
    </ScrollViewer>

</UserControl>
