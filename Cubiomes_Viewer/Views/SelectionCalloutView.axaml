<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="using:Cubiomes_Viewer.Controls"
             xmlns:data="using:Cubiomes_Viewer.Data"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cubiomes_Viewer.ViewModels"
             xmlns:views="using:Cubiomes_Viewer.Views"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="90"
             x:Class="Cubiomes_Viewer.Views.SelectionCalloutView"
             x:DataType="vm:SelectionViewModel">

    <Border Classes="callout" IsVisible="{Binding IsOpen}">
        <StackPanel Classes="callout">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Panel IsVisible="{Binding Marker, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center">
                    <views:MarkerBadgeView DataContext="{Binding Marker}"/>
                </Panel>
                <ComboBox Classes="pin-look" IsVisible="{Binding IsPin}" ItemsSource="{Binding PinLooks}" SelectedItem="{Binding SelectedPinLook}"
                          ToolTip.Tip="{Binding PinLookLabel}">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="data:PinLookChoice">
                            <controls:PinIcon Fill="{Binding Look.Fill}" Glyph="{Binding Look.Glyph}" ToolTip.Tip="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="1" Classes="callout-title" Text="{Binding Title}" IsVisible="{Binding !IsNamable}"/>
                <TextBox Grid.Column="1" Classes="callout-title" Text="{Binding Name}" PlaceholderText="{Binding NamePlaceholder}" IsVisible="{Binding IsNamable}"
                         ToolTip.Tip="{Binding NameLabel}"/>
                <Button Grid.Column="2" Classes="card-close" IsVisible="{Binding IsNamable}" Command="{Binding RemoveCommand}" ToolTip.Tip="{Binding RemoveLabel}">
                    <controls:SvgIcon Source="{StaticResource DeleteIcon}"/>
                </Button>
                <Button Grid.Column="3" Classes="card-close" Command="{Binding CloseCommand}" ToolTip.Tip="{Binding CloseLabel}">
                    <controls:SvgIcon Source="{StaticResource CloseIcon}"/>
                </Button>
            </Grid>

            <TextBlock Classes="damp" Text="{Binding PositionText}" TextWrapping="Wrap"/>
            <TextBlock Classes="damp" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Classes="damp" Text="{Binding LoadingLabel}" IsVisible="{Binding IsLoading}"/>
            <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Classes="callout" IsVisible="{Binding ChestLoot.IsAvailable}">
                <ToggleButton Classes="expander" IsChecked="{Binding ChestLoot.IsExpanded}">
                    <Grid ColumnDefinitions="Auto,*">
                        <controls:SvgIcon Classes="chevron" Source="{StaticResource ExpandIcon}"/>
                        <TextBlock Grid.Column="1" Classes="condition-title" Text="{Binding ChestLoot.Header}" VerticalAlignment="Center"/>
                    </Grid>
                </ToggleButton>
                <StackPanel Classes="callout" IsVisible="{Binding ChestLoot.IsExpanded}">
                    <TextBlock Classes="damp" Text="{Binding ChestLoot.LoadingLabel}" IsVisible="{Binding ChestLoot.IsLoading}"/>
                    <TextBlock Classes="damp" Text="{Binding ChestLoot.Message}" TextWrapping="Wrap"
                               IsVisible="{Binding ChestLoot.Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Border Classes="chest-list" IsVisible="{Binding ChestLoot.HasChests}">
                        <ScrollViewer>
                            <ItemsControl Classes="chests" ItemsSource="{Binding ChestLoot.Chests}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChestViewModel">
                                        <StackPanel>
                                            <ToggleButton Classes="expander" IsChecked="{Binding IsExpanded}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <controls:SvgIcon Classes="chevron" Source="{StaticResource ExpandIcon}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ToggleButton>
                                            <ItemsControl Classes="chest-contents" ItemsSource="{Binding Contents}" IsVisible="{Binding IsExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Classes="damp" Text="{Binding ChestLoot.Note}" TextWrapping="Wrap"
                               IsVisible="{Binding ChestLoot.Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
