<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Cubiomes_Viewer.Controls">

    <Style Selector="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ComboBox.fill">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="DropDownButton.fill">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <Style Selector="controls|MapView">
        <Setter Property="Background" Value="{DynamicResource MapBackgroundColor}"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="TextBlock.damp">
        <Setter Property="Foreground" Value="{DynamicResource FontColorDamp}"/>
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessColor}"/>
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
    </Style>
    <Style Selector="TextBlock.check">
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.field-label">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource FontColorDamp}"/>
    </Style>
    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>

    <Style Selector=":is(Control).section-content">
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <Style Selector="Image.tile-preview">
        <Setter Property="MaxWidth" Value="192"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style Selector="Border.world-bar">
        <Setter Property="Background" Value="{DynamicResource RegionColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="WrapPanel.toolbar-group">
        <Setter Property="ItemSpacing" Value="6"/>
        <Setter Property="LineSpacing" Value="4"/>
        <Setter Property="Margin" Value="0,2,18,2"/>
    </Style>
    <Style Selector="WrapPanel.toolbar-group > CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.seed">
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="NumericUpDown.compact">
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.compact">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="StackPanel.form">
        <Setter Property="Spacing" Value="8"/>
    </Style>
    <Style Selector="StackPanel.marker-label">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="8"/>
    </Style>
    <Style Selector="Border.marker">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MarkerOutlineColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Viewbox.marker-glyph">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
    </Style>
    <Style Selector="Path.marker-glyph">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Fill" Value="{DynamicResource MarkerGlyphColor}"/>
    </Style>
    <Style Selector="StackPanel.flyout-form">
        <Setter Property="Spacing" Value="8"/>
        <Setter Property="MinWidth" Value="200"/>
    </Style>

    <Style Selector="ListBox.rail">
        <Setter Property="Background" Value="{DynamicResource RegionColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.rail ListBoxItem">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox.rail PathIcon">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="ListBox.bottom-nav">
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <Style Selector="Border.side-panel">
        <Setter Property="Width" Value="320"/>
        <Setter Property="Background" Value="{DynamicResource RegionColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>
    <Style Selector="Border.sheet">
        <Setter Property="Background" Value="{DynamicResource RegionColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="CornerRadius" Value="12,12,0,0"/>
        <Setter Property="MaxHeight" Value="380"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="StackPanel.panel">
        <Setter Property="Margin" Value="16"/>
        <Setter Property="Spacing" Value="8"/>
    </Style>

    <Style Selector="Grid.pair">
        <Setter Property="ColumnSpacing" Value="8"/>
        <Setter Property="RowSpacing" Value="4"/>
    </Style>
    <Style Selector="ItemsControl.conditions">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="8"/>
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.condition">
        <Setter Property="Background" Value="{DynamicResource RegionColorDamp}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="Border.condition.problem">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}"/>
    </Style>
    <Style Selector="ToggleButton.condition-header">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style Selector="ToggleButton.condition-header:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.condition-header:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.condition-header:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource FontColor}"/>
    </Style>
    <Style Selector="TextBlock.condition-title">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.problem">
        <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.choice-list">
        <Setter Property="MaxHeight" Value="200"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>
    <Style Selector="ListBox.results">
        <Setter Property="MaxHeight" Value="240"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="ListBox.results ListBoxItem">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource RegionColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="MaxWidth" Value="320"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Button.card-close">
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.card-close PathIcon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
    </Style>
    <Style Selector="WrapPanel.card-actions">
        <Setter Property="ItemSpacing" Value="6"/>
        <Setter Property="LineSpacing" Value="6"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style Selector="WrapPanel.card-actions > Button">
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style Selector="Border.legend">
        <Setter Property="Background" Value="{DynamicResource RegionColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="StackPanel.legend">
        <Setter Property="Spacing" Value="4"/>
        <Setter Property="MinWidth" Value="160"/>
    </Style>
    <Style Selector="TextBlock.legend-title">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.legend-label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource FontColorDamp}"/>
    </Style>
    <Style Selector="Border.legend-ramp">
        <Setter Property="Height" Value="10"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.status-bar">
        <Setter Property="Background" Value="{DynamicResource RegionColor}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style Selector="Border.hover-chip">
        <Setter Property="Background" Value="{DynamicResource RegionColor}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

</Styles>
