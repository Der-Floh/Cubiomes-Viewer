<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The Material Symbols of the buttons in their outlined form; icons without a filled form are the same in both. -->
    <x:String x:Key="IconStyle">Outlined</x:String>

    <x:String x:Key="LayersIcon">/Assets/Icons/layers.svg</x:String>
    <x:String x:Key="SearchIcon">/Assets/Icons/search.svg</x:String>
    <x:String x:Key="AnalysisIcon">/Assets/Icons/bar_chart.svg</x:String>
    <x:String x:Key="ExportIcon">/Assets/Icons/download.svg</x:String>
    <x:String x:Key="MapWindowIcon">/Assets/Icons/open_in_new.svg</x:String>
    <x:String x:Key="SettingsIcon">/Assets/Icons/settings.svg</x:String>
    <x:String x:Key="DiceIcon">/Assets/Icons/casino.svg</x:String>
    <x:String x:Key="GoToIcon">/Assets/Icons/my_location.svg</x:String>
    <x:String x:Key="HomeIcon">/Assets/Icons/home.svg</x:String>
    <x:String x:Key="PinDropIcon">/Assets/Icons/pin_drop.svg</x:String>
    <x:String x:Key="PlusIcon">/Assets/Icons/add.svg</x:String>
    <x:String x:Key="MinusIcon">/Assets/Icons/remove.svg</x:String>
    <x:String x:Key="CloseIcon">/Assets/Icons/close.svg</x:String>
    <x:String x:Key="DeleteIcon">/Assets/Icons/delete.svg</x:String>
    <x:String x:Key="FilterIcon">/Assets/Icons/filter_alt.svg</x:String>

</ResourceDictionary>
