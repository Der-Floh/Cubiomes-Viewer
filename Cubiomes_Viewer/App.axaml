<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Cubiomes_Viewer"
             x:Class="Cubiomes_Viewer.App"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Accents/Themes.axaml"/>
                <ResourceInclude Source="/Accents/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" RegionColor="{StaticResource Palette.RegionColor.Light}" Accent="{StaticResource Palette.AccentColor.Light}"/>
                <ColorPaletteResources x:Key="Dark" RegionColor="{StaticResource Palette.RegionColor.Dark}" Accent="{StaticResource Palette.AccentColor.Dark}"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Accents/Styles.axaml"/>
    </Application.Styles>
</Application>
